        self.make_label(top, title, 22, WHITE, True, bg=BG).pack(anchor="w")
        if subtitle:
            self.make_label(top, subtitle, 10, MUTED, bg=BG).pack(anchor="w", pady=(4, 0))

        body = tk.Frame(content, bg=BG)
        body.pack(fill="both", expand=True)
        return body

