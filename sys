                    print("Invalid lesson number.")

            else:
                print("Please enter a valid number.")

    # ==============================
    # MY LEARNING PROGRESS
    # ==============================

    elif choice == "2":

        print("\n==========================================")
        print("             MY LEARNING PROGRESS")
        print("==========================================")

        for number in lessons:

            if number in completed:
                status = "COMPLETED"
            else:
                status = "NOT YET COMPLETED"

            print(f"Lesson {number}: {status}")

        print("------------------------------------------")
        print("Completed lessons:", len(completed), "/", len(lessons))

        progress = (len(completed) / len(lessons)) * 100

        print("Progress:", round(progress, 2), "%")

        input("\nPress Enter to return to dashboard...")

