class CodeQuestApp:
    def __init__(self, root):
        self.root = root
        self.root.title("CODE QUEST | Interactive Learning Portal")
        self.root.geometry("1180x760")
        self.root.minsize(900, 620)
        self.root.configure(bg=BG)

        self.username = ""
        self.password = ""
        self.completed = set()
        self.current_page = None
        self.quiz_index = 0
        self.quiz_score = 0
        self.quiz_answers = []
        self.selected_answer = tk.StringVar(value="")

        self.show_register()

    def clear(self):
        for widget in self.root.winfo_children():
            widget.destroy()

    def make_label(self, parent, text, size=12, color=WHITE, bold=False, **kwargs):
        return tk.Label(
            parent, text=text, bg=kwargs.pop("bg", parent.cget("bg")),
            fg=color, font=("Segoe UI", size, "bold" if bold else "normal"),
            justify=kwargs.pop("justify", "left"), wraplength=kwargs.pop("wraplength", 800),
            **kwargs
        )

    def make_button(self, parent, text, command, primary=True, width=None):
        bg = TEAL if primary else PANEL_LIGHT
        fg = DARK if primary else WHITE
        return tk.Button(
            parent, text=text, command=command, bg=bg, fg=fg,
            activebackground=LIME if primary else "#20545E",
            activeforeground=DARK if primary else WHITE,
            relief="flat", bd=0, cursor="hand2",
            font=("Segoe UI", 10, "bold"), padx=18, pady=11,
            width=width
        )

    def header(self, parent, small=False):
        self.make_label(parent, "CQ", 28 if not small else 20, TEAL, True).pack(pady=(0, 2))
        self.make_label(parent, "CODE QUEST", 22 if not small else 17, WHITE, True).pack()
        self.make_label(parent, "INTERACTIVE LEARNING PORTAL", 9, MUTED, True).pack(pady=(2, 12))

    def entry_field(self, parent, label, show=None):
        self.make_label(parent, label, 9, TEAL, True).pack(anchor="w", pady=(10, 5))
        entry = tk.Entry(
            parent, font=("Segoe UI", 12), bg="#F2F7F7", fg="#152B30",
            insertbackground="#152B30", relief="flat", show=show
        )
        entry.pack(fill="x", ipady=10)
        return entry

    def show_register(self):
        self.clear()
        outer = tk.Frame(self.root, bg=BG)
        outer.pack(expand=True)
        self.header(outer)

        card = tk.Frame(outer, bg=PANEL, padx=28, pady=24,
                        highlightbackground="#42616A", highlightthickness=1)
        card.pack()

        self.make_label(card, "CREATE YOUR ACCOUNT", 16, LIME, True, bg=PANEL).pack(anchor="w")
        self.make_label(card, "Start your journey. Learn Python one lesson at a time.",
                        9, MUTED, bg=PANEL).pack(anchor="w", pady=(7, 12))

        self.reg_user = self.entry_field(card, "USERNAME")
        self.reg_pass = self.entry_field(card, "PASSWORD", "•")
        self.reg_confirm = self.entry_field(card, "CONFIRM PASSWORD", "•")

        self.make_button(card, "CREATE ACCOUNT   →", self.register, True).pack(fill="x", pady=(18, 0))
        self.make_button(outer, "Already have an account? Log in", self.show_login, False).pack(pady=12)
        self.make_label(outer, "A focused space for curious minds.", 9, MUTED).pack(pady=5)

    def register(self):
        username = self.reg_user.get().strip()
        password = self.reg_pass.get()
        confirm = self.reg_confirm.get()

        if not username or not password or not confirm:
            messagebox.showwarning("Missing information", "Please complete all fields.")
            return
        if password != confirm:
            messagebox.showerror("Password mismatch", "Your passwords do not match.")
            return

        self.username = username
        self.password = password
        messagebox.showinfo("Account created", "Your account was created successfully!")
        self.show_login()

    def show_login(self):
        self.clear()
        outer = tk.Frame(self.root, bg=BG)
        outer.pack(expand=True)
        self.header(outer)

        card = tk.Frame(outer, bg=PANEL, padx=30, pady=28,
                        highlightbackground="#42616A", highlightthickness=1)
        card.pack()

        self.make_label(card, "WELCOME BACK", 16, LIME, True, bg=PANEL).pack(anchor="w")
        self.make_label(card, "Log in to continue learning.", 9, MUTED, bg=PANEL).pack(anchor="w", pady=(7, 12))

        self.login_user = self.entry_field(card, "USERNAME")
        self.login_pass = self.entry_field(card, "PASSWORD", "•")
        self.make_button(card, "LOG IN   →", self.login, True).pack(fill="x", pady=(20, 0))
        self.make_button(outer, "Create a new account", self.show_register, False).pack(pady=12)

    def login(self):
        if self.login_user.get().strip() == self.username and self.login_pass.get() == self.password:
            self.show_dashboard()
        else:
            messagebox.showerror("Login failed", "Incorrect username or password.")

    def app_shell(self, title, subtitle=""):
        self.clear()
        shell = tk.Frame(self.root, bg=BG)
        shell.pack(fill="both", expand=True)

        sidebar = tk.Frame(shell, bg="#0B2831", width=225)
        sidebar.pack(side="left", fill="y")
        sidebar.pack_propagate(False)

        self.make_label(sidebar, "CQ", 27, TEAL, True, bg="#0B2831").pack(pady=(24, 0))
