def clear_screen():
    for widget in root.winfo_children():
        widget.destroy()


def create_title(parent, text, size=22):
    tk.Label(
        parent,
        text=text,
        font=("Arial", size, "bold"),
        bg=BG,
        fg=WHITE
    ).pack(pady=15)


def create_button(parent, text, command, color=BLUE):
    return tk.Button(
        parent,
        text=text,
        command=command,
        font=("Arial", 12, "bold"),
        bg=color,
        fg=WHITE,
        activebackground=LIGHT_BLUE,
        activeforeground=WHITE,
        relief="flat",
        cursor="hand2",
        width=25,
        height=2
    )


