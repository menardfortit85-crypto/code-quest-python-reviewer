def take_quiz():
    score = 0

    print("\n==========================================")
    print("              CODE QUEST QUIZ")
    print("==========================================")
    print("There are 15 questions.")
    print("Choose the correct answer: A, B, C, or D.")
    print("------------------------------------------")

    for number, question in enumerate(quiz_questions, start=1):

        print(f"\nQUESTION {number}/15")
        print(question["question"])

        for choice in question["choices"]:
            print(choice)

        while True:
            answer = input("\nYour answer: ").upper()

            if answer in ["A", "B", "C", "D"]:
                break
            else:
                print("Invalid answer. Enter A, B, C, or D.")

        if answer == question["answer"]:
            print("Correct answer!")
            score += 1
        else:
            print("Incorrect answer.")
            print("Correct answer:", question["answer"])

        input("\nPress Enter to continue...")

    percentage = (score / len(quiz_questions)) * 100

    print("\n==========================================")
    print("              QUIZ RESULTS")
    print("==========================================")
    print("Student:", registered_name)
    print("Score:", score, "/", len(quiz_questions))
    print("Percentage:", round(percentage, 2), "%")

    if score >= 13:
        print("Remark: EXCELLENT!")
    elif score >= 10:
        print("Remark: VERY GOOD!")
    elif score >= 7:
        print("Remark: GOOD EFFORT!")
    else:
        print("Remark: KEEP PRACTICING!")

    print("==========================================")

    input("\nPress Enter to return to the dashboard...")


