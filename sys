def login_screen():
    clear_screen()

    create_title(root, "CODE QUEST", 28)

    tk.Label(
        root,
        text="LOGIN TO YOUR ACCOUNT",
        font=("Arial", 12),
        bg=BG,
        fg=LIGHT_BLUE
    ).pack(pady=5)

    panel = tk.Frame(root, bg=PANEL, padx=40, pady=35)
    panel.pack(pady=40)

    tk.Label(
        panel,
        text="USERNAME",
        bg=PANEL,
        fg=GRAY
    ).pack(anchor="w")

    username_entry = tk.Entry(
        panel,
        font=("Arial", 13),
        width=30
    )
    username_entry.pack(pady=10)

    tk.Label(
        panel,
        text="PASSWORD",
        bg=PANEL,
        fg=GRAY
    ).pack(anchor="w")

    password_entry = tk.Entry(
        panel,
        font=("Arial", 13),
        width=30,
        show="*"
    )
    password_entry.pack(pady=10)

    def login():
        if (
            username_entry.get() == registered_name
            and password_entry.get() == registered_password
        ):
            messagebox.showinfo(
                "Login Successful",
                "Welcome, " + registered_name + "!"
            )
            dashboard()
        else:
            messagebox.showerror(
                "Login Failed",
                "Incorrect username or password."
            )

    create_button(
        panel,
        "LOGIN",
        login,
        GREEN
    ).pack(pady=20)


