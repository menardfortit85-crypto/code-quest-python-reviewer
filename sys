                  font=("Segoe UI", 10), padx=20, pady=12, cursor="hand2").pack(fill="x", side="bottom")

        content = tk.Frame(shell, bg=BG, padx=30, pady=24)
        content.pack(side="left", fill="both", expand=True)

        top = tk.Frame(content, bg=BG)
