def explore_lessons():
    clear_screen()

    create_title(root, "EXPLORE LESSONS", 24)

    main_frame = tk.Frame(root, bg=BG)
    main_frame.pack(fill="both", expand=True, padx=35, pady=10)

    left_frame = tk.Frame(main_frame, bg=PANEL, width=300)
    left_frame.pack(side="left", fill="y", padx=10)

    right_frame = tk.Frame(main_frame, bg=PANEL)
    right_frame.pack(side="right", fill="both", expand=True, padx=10)

    tk.Label(
        left_frame,
        text="LESSON LIST",
        font=("Arial", 15, "bold"),
        bg=PANEL,
        fg=WHITE
    ).pack(pady=15)

    content_title = tk.Label(
        right_frame,
        text="SELECT A LESSON",
        font=("Arial", 17, "bold"),
        bg=PANEL,
        fg=LIGHT_BLUE
    )
    content_title.pack(pady=15)

    text_frame = tk.Frame(right_frame, bg=PANEL)
    text_frame.pack(fill="both", expand=True, padx=15, pady=5)

    scrollbar = tk.Scrollbar(text_frame)
    scrollbar.pack(side="right", fill="y")

    lesson_text = tk.Text(
        text_frame,
        font=("Arial", 11),
        bg="#0F172A",
        fg=WHITE,
        wrap="word",
        yscrollcommand=scrollbar.set,
        padx=15,
        pady=15,
        relief="flat"
    )
    lesson_text.pack(fill="both", expand=True)

    scrollbar.config(command=lesson_text.yview)

    def show_lesson(number):
        content_title.config(text=lessons[number]["title"])

        lesson_text.config(state="normal")
        lesson_text.delete("1.0", tk.END)
        lesson_text.insert("1.0", lessons[number]["content"])
        lesson_text.config(state="disabled")

        if number not in completed:
            completed.append(number)

    for number in lessons:
        create_button(
            left_frame,
            f"Lesson {number}",
            lambda n=number: show_lesson(n)
        ).pack(pady=4)

    create_button(
        left_frame,
        "BACK TO DASHBOARD",
        dashboard,
        RED
    ).pack(pady=15)


