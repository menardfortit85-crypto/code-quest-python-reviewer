# REGISTRATION SCREEN
# ==========================================

def register_screen():
    clear_screen()

    create_title(root, "CODE QUEST", 28)

    tk.Label(
        root,
        text="INTERACTIVE LEARNING PORTAL",
        font=("Arial", 12),
        bg=BG,
        fg=LIGHT_BLUE
    ).pack(pady=5)

    panel = tk.Frame(root, bg=PANEL, padx=40, pady=30)
    panel.pack(pady=35)

    tk.Label(
        panel,
        text="CREATE ACCOUNT",
        font=("Arial", 18, "bold"),
        bg=PANEL,
        fg=WHITE
    ).pack(pady=15)

    tk.Label(
        panel,
        text="Create Username",
        bg=PANEL,
        fg=GRAY
    ).pack(anchor="w")

    username_entry = tk.Entry(
        panel,
        font=("Arial", 12),
        width=30
    )
    username_entry.pack(pady=8)

    tk.Label(
        panel,
        text="Create Password",
        bg=PANEL,
        fg=GRAY
    ).pack(anchor="w")

    password_entry = tk.Entry(
        panel,
        font=("Arial", 12),
        width=30,
        show="*"
    )
    password_entry.pack(pady=8)

    tk.Label(
        panel,
        text="Confirm Password",
        bg=PANEL,
        fg=GRAY
    ).pack(anchor="w")

    confirm_entry = tk.Entry(
        panel,
        font=("Arial", 12),
        width=30,
        show="*"
    )
    confirm_entry.pack(pady=8)

    def create_account():
        global registered_name, registered_password

        username = username_entry.get().strip()
        password = password_entry.get()
        confirm = confirm_entry.get()

        if not username or not password or not confirm:
            messagebox.showwarning(
                "Missing Information",
                "Please complete all fields."
            )
            return

        if password != confirm:
            messagebox.showerror(
                "Password Error",
                "Passwords do not match."
            )
            return

        registered_name = username
        registered_password = password

        messagebox.showinfo(
            "Success",
            "Account registered successfully!"
        )

        login_screen()

    create_button(
        panel,
        "CREATE ACCOUNT",
        create_account,
        GREEN
    ).pack(pady=20)


